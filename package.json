{
  "name": "esbuild-plugin-replace",
  "version": "2.0.0",
  "description": "Replace strings in files while bundling with esbuild",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": "naecoo<ocean7hy@gmail.com>",
  "license": "MIT",
  "keywords": [
    "esbuild",
    "plugin",
    "replace",
    "string-replacement",
    "build-plugin"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naecoo/esbuild-plugin-replace.git"
  },
  "homepage": "https://naecoo.github.io/esbuild-plugin-replace/",
  "bugs": "https://github.com/naecoo/esbuild-plugin-replace/issues",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:type": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  }
}
